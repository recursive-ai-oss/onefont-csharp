<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>$(LibName).AotSmoke</RootNamespace>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="../testdata/fonts/NotoSansArabic-Subset-Regular.ttf" Link="fonts/NotoSansArabic-Subset-Regular.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../testdata/fonts/NotoSansDevanagari-Subset-Regular.ttf" Link="fonts/NotoSansDevanagari-Subset-Regular.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../testdata/fonts/NotoSans-Subset-Regular.ttf" Link="fonts/NotoSans-Subset-Regular.ttf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OneFont/OneFont.csproj" />
  </ItemGroup>

</Project>
